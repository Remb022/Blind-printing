<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.demo.activity.BlindPrintingController"
           stylesheets="@../css/blind_printing_activity.css">

    <AnchorPane styleClass="back-color"
                maxHeight="Infinity"
                maxWidth="Infinity">

        <!-- Иконка выхода -->
        <HBox alignment="CENTER"
              styleClass="more-vert"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <ImageView preserveRatio="true" fitHeight="40" fitWidth="40">
                <image>
                    <Image url="@../icon/More_vert.png"/>
                </image>
            </ImageView>
        </HBox>

        <VBox alignment="CENTER"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <!-- Таймер -->
            <HBox prefHeight="50"
                  alignment="CENTER">
                <Text text="01:20" styleClass="timer"/>
            </HBox>

            <!-- Набор текста -->
            <VBox alignment="CENTER" maxWidth="700" prefWidth="700">
                <HBox prefHeight="90" maxHeight="90"/>

                <!-- Набор текста -->
                <HBox alignment="CENTER_LEFT" styleClass="h-box-text">
                    <Text text="набирающийся текст" styleClass="text"/>
                </HBox>

                <!-- Полоса -->
                <HBox maxHeight="3"
                      prefHeight="3"
                      styleClass="line">
                </HBox>

                <!-- Текст -->
                <HBox alignment="CENTER_LEFT" styleClass="h-box-text">
                    <Text text="какой-то там текст" styleClass="text"/>
                </HBox>
            </VBox>

        </VBox>

    </AnchorPane>
</StackPane>
